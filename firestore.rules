rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // users/{uid} - profile doc, keyed by the owning Firebase Auth uid.
    // Anyone signed in can read profiles (search, feed, profile pages all
    // need to look up other users). Only the owner can create/update their
    // own doc. Field-level writes here (likes, shares, saves, status) are
    // all performed as updates by the acting user on their own doc, or as
    // arrayUnion/arrayRemove on the *post's* owner doc's aggregate fields -
    // see USER_POSTS below for why those need a broader write rule.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    // USER_POSTS/{postId} - a single post. Field name is POST_OWNER_DETAIL.POID.
    // Only the post owner can create/delete their post. Likes/shares are
    // stored as arrayUnion/arrayRemove on POST_DETAIL.LIKES/SHARES by *any*
    // signed-in user (liking someone else's post), so update is intentionally
    // broader than owner-only - lock down further if abuse becomes a concern
    // (e.g. only allow updates that touch LIKES/SHARES, not POST_DETAIL.POST_CAPTION).
    match /USER_POSTS/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.POST_OWNER_DETAIL.POID == request.auth.uid;
      allow update: if request.auth != null;
      allow delete: if request.auth != null
        && resource.data.POST_OWNER_DETAIL.POID == request.auth.uid;
    }

    // USER_STORYS/{storyId} - a single story. Field name is STORY_OWNER_DETAIL.STOID.
    match /USER_STORYS/{storyId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.STORY_OWNER_DETAIL.STOID == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.STORY_OWNER_DETAIL.STOID == request.auth.uid;
      allow update: if false;
    }

    // MESSAGES/{messageId} - direct messages. `mid` is a deterministic
    // sorted pair of the two participant uids (see threadId() in
    // src/lib/firestore/messages.ts). Only a participant in that thread
    // may read it; only the sender may create it; messages are immutable.
    match /MESSAGES/{messageId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.mid.split("_");
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.auth.uid in request.resource.data.mid.split("_");
      allow update, delete: if false;
    }

    // NOTIFICATION/{notificationId} - only the target user can read their
    // own notifications; any signed-in user can create one targeting
    // someone else (e.g. liking their post triggers a notification for them).
    match /NOTIFICATION/{notificationId} {
      allow read: if request.auth != null
        && resource.data.target == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // COMMENTS/{commentId} - comments are public once posted (read is not
    // field-scoped since every read here is always via a where("postId", ...)
    // query, never an unscoped list). Only the author can delete their own.
    match /COMMENTS/{commentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid;
      allow update: if false;
      allow delete: if request.auth != null
        && resource.data.authorId == request.auth.uid;
    }

    // FOLLOWS/{followId} - a follow edge, doc ID is `${followerId}_${followingId}`.
    // Only the follower can create/delete their own follow edge. Reads are
    // always scoped by a where() on followerId or followingId (see
    // fetchFollowing/fetchFollowers), never an unscoped list.
    match /FOLLOWS/{followId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.followerId == request.auth.uid;
      allow update: if false;
      allow delete: if request.auth != null
        && resource.data.followerId == request.auth.uid;
    }

    // ACTIVITY/{activityId} - a private per-user activity log. Only the
    // owning user can read or create their own rows (queried via
    // where("userId", "==", uid), never an unscoped list). Immutable.
    match /ACTIVITY/{activityId} {
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
